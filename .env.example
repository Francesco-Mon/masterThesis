# Copy to .env (git-ignored). Never commit a real key.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Models (check the OpenRouter models page: structured-outputs filter)
GROUNDER_MODEL_FREE=nvidia/nemotron-3.5-super-vl:free
GROUNDER_MODEL_CHEAP=openai/gpt-oss-120b
GROUNDER_MODEL_FINAL=
# Client-side limits (defaults shown)
LLM_RPM=20
MAX_COST_USD=0.5
